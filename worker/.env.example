# Copy this to a local .env file; load it via your hosting environment, not Git.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nexus
MYSQL_USER=nexus_worker
MYSQL_PASSWORD=change_me
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXUS_API_TOKEN=replace_with_long_random_secret
NEXUS_PUBLIC_READ=true
